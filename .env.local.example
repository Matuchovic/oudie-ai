# Copy to .env.local for local work, and paste the same two into
# Vercel → Settings → Environment Variables for production.
#
# Both are safe in the browser. The anon key is public by design — row
# level security decides what it can reach.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# The service role key does NOT belong here, in Vercel's NEXT_PUBLIC_
# variables, or anywhere else in this project. It bypasses row level
# security entirely.
